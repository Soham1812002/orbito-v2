# Docker Hub
DOCKERHUB_USERNAME=your-dockerhub-username

# PostgreSQL
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=orbito_auth

# Backend — Database Connection String
AUTH_POSTGRES_URI=postgresql://app_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/orbito_auth

# Backend — JWT
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Backend — CORS (comma-separated origins)
CORS_ORIGINS=https://your-domain.com

# Backend — Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Seeding — Super Admin (used on first migration run)
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD
