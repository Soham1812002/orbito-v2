# Server Configuration
PORT=9000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# Authentication & JWT
JWT_SECRET=super-secret-jwt-key-replace-in-production-orbito-v2
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
